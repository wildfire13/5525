extends "res://tests/feedback_261019_2.gd"
func labels():return game.find_children("*","Label",true,false).map(func(n):return n.text)
func load_at(seed,place):
	var s=seed.duplicate(true);s.state.location=place
	await game.update({"op":"campaign_load","data":s});await settle()
func run():
	create_timer(140).timeout.connect(func():print("FAIL feedback3 watchdog");quit(2))
	if evidence.is_empty() or not OS.get_user_data_dir().begins_with(evidence+"/"):quit(2);return
	root.size=Vector2i(1920,1080);game=load("res://main.tscn").instantiate();root.add_child(game)
	while game.data.is_empty():await process_frame
	await preload("res://tests/current_historical_fixture.gd").install(game)
	game.checks_fast=true;game.audio.fast_mode=true;await settle()
	check(game.audio.muted.values().all(func(v):return v),"playtest starts with all audio muted")
	var menu_labels=game.menu.find_children("*","Button",true,false).map(func(b):return b.text)
	check(menu_labels.slice(0,3)==["セーブ","ロード","行動ログ"] and menu_labels.slice(-2)==["新しい旅","閉じる"],"menu labels and order")
	check(not menu_labels.has("画像") and not menu_labels.has("拠点・旅程へ"),"redundant menu navigation and portrait entry removed")
	var seed=await saved();seed.state.characters.guard.inventory["sword-wood"]=1;seed.state.characters.guard.hp=1;seed.state.history.append("履歴保持テスト");seed.state.hours=123
	for place in ["east","west","north","south"]:
		await load_at(seed,place);await enter_facility("shop");await settle();return_layout("TownReturn")
		var chooser=node("ShopSlotFilter");check(chooser!=null and chooser.get_item_text(0)=="商品リスト（すべて）" and chooser.get_item_icon(0)==null,"all product heading has blank icon "+place)
		check(not labels().has("装備を購入") and not labels().has("部位フィルター"),"duplicate shop headings removed "+place)
		var id="spear" if place=="east" else "feet" if place=="west" else "accessory1" if place=="north" else "potion"
		game.pages.shop_view.select_slot(id);await settle()
		var products=game.pages.shop_view.offered();check(not products.is_empty() and products.all(func(g):return g.get("type")==id if place=="east" else g.id==id if place=="south" else g.get("allowedSlots",[g.slot]).has(id)),"department appropriate filter "+place)
		check(node("ShopSlotFilter").item_count==1 if place=="north" else node("ShopSlotFilter").get_item_icon(node("ShopSlotFilter").selected)!=null,"department appropriate filter options "+place)
		await pointer_click(node("TownReturn"));check(game.page=="shop" and node("FacilityChoice_buy")!=null,"shop return pointer restores service entry "+place)
	await load_at(seed,"east");game.navigate("board");await settle();return_layout("TownReturn")
	check(game.header.text=="イース" and labels().has("掲示板") and not labels().has("直近の記録") and not labels().any(func(t):return t.contains("累計123") or t.contains("編成5人")),"board heading clean and history moved")
	var before=await saved();game.show_action_log();await settle()
	check(node("ActionLogHours").text=="ゲーム内経過時間:123時間" and node("ActionLogHistory").text.contains("履歴保持テスト") and node("ActionLogSave")!=null,"action log contains hours history and export")
	await click("ActionLogSave")
	var files=game.find_children("*","FileDialog",true,false).filter(func(w):return w.visible)
	check(files.size()==1 and files[0].file_mode==FileDialog.FILE_MODE_SAVE_FILE,"action log export opens save dialog")
	if not files.is_empty():files[0].canceled.emit();await settle()
	check(await saved()==before and is_instance_valid(game.dialog.window),"cancel log export preserves campaign and log window")
	game.dialog.close();await settle();check(await saved()==before,"log inspection preserves full campaign")
	await enter_facility("shop");await settle()
	game.preferences.store_rect("status",Rect2(120,60,1040,700));game.preferences.config.set_value("migration","status_feedback3",false)
	game.pages.party_view.open_detail("guard");await settle()
	check(game.dialog.window.size==Vector2i(1760,700),"old narrow status widens whole window once without changing height")
	check(not game.dialog.body.get_parent().get_parent().find_children("*","Label",true,false).any(func(n):return n.text=="キャラクターステータス"),"status title appears only in window titlebar")
	check(node("OwnedEquipmentOwner").text==game.member_name("guard")+"のインベントリ" and node("OwnedEquipmentOwner").get_parent()==node("OwnedEquipmentSlot").get_parent(),"owner heading and filter share one row")
	check(absf(node("OwnedEquipment_potion").get_global_rect().end.x-node("OwnedEquipment_sword-wood").get_global_rect().end.x)<2,"item name column right edges align")
	check(node("OwnedInventoryUse_potion")!=null and node("OwnedInventorySell_sword-wood")!=null,"direct use and sale coexist in equipment inventory")
	before=await saved();await click("OwnedInventoryUse_potion")
	check(game.pages.party_view.inventory_view.action=="use" and node("InventoryTarget_guard")!=null,"direct use opens existing target selector")
	await click("InventoryTarget_guard");await consent(false);check(await saved()==before,"direct use cancel leaves full save unchanged")
	await click("StatusTab_0");await click("OwnedInventorySell_sword-wood");await click("InventoryPrepareSale");await consent(false)
	check(await saved()==before,"direct sale cancel leaves gold and inventory unchanged")
	await click("StatusTab_0")
	for resolution in [Vector2i(1920,1080)]:
		root.size=resolution;await settle();game.dialog.window.size=Vector2i(resolution.x,700);game.dialog.window.position=Vector2i(0,40);await settle();alignment()
		var source=node("OwnedEquipmentActions_sword-wood");source.focus_entered.emit();await settle();var hover=node("EquipmentHover")
		var anchor=Vector2(game.dialog.window.position)+source.get_global_rect().position
		check(hover.visible and Rect2(Vector2.ZERO,Vector2(root.size)).encloses(Rect2(Vector2(hover.position),Vector2(hover.size))),"comparison remains onscreen "+str(resolution))
		check(absf(float(hover.position.x+hover.size.x)-anchor.x)<30 or absf(float(hover.position.x)-anchor.x-source.size.x)<30,"comparison stays next to candidate "+str(resolution))
		check(node("OwnedInventorySell_sword-wood").get_global_rect().end.x<=game.dialog.window.size.x,"sale fits whole status "+str(resolution))
	game.dialog.window.size=Vector2i(1100,700);game.dialog.close();await settle();game.pages.party_view.open_detail("guard");await settle()
	check(game.dialog.window.size==Vector2i(1100,700),"manual resize after migration remains saved")
	game.dialog.close();await game.new_game();await preload("res://tests/current_historical_fixture.gd").install(game);await settle()
	await game.act("accept",[game.campaign().board[0].id,"porter"]);var gold=game.campaign().gold;await game.act("depart",["east"])
	var arrival=await saved();arrival.state.phase="arrival";arrival.state.journey.phase="delivery";arrival.state.journey.stage=2;arrival.state.journey.hours=4;arrival.state.journey.party=game.roster().filter(func(u):return game.campaign().selected.has(u.id)).duplicate(true)
	await game.update({"op":"campaign_load","data":arrival});await settle()
	check(game.page=="hub" and game.campaign().gold==gold and node("HubDeliverCargo")!=null,"arrival keeps manual hub delivery")
	await click("HubDeliverCargo");check(game.campaign().phase=="result" and game.results_view.active and node("ResultTitle").text=="配達達成" and game.results_view.current.kind=="quest" and game.footer.text.is_empty(),"delivery result has distinct confirmed quest receipt and no obsolete guidance")
	check(not game.find_children("*","Button",true,false).any(func(b):return b.text in ["旅程","道具"]),"result removes obsolete travel item tabs")
	check(node("ResultContinue").text=="広場へ" and Rect2(Vector2.ZERO,Vector2(root.size)).encloses(node("ResultContinue").get_global_rect()),"dedicated quest result keeps its fixed return action onscreen");var completed=await saved();await pointer_click(node("ResultContinue"))
	check(game.page=="hub" and game.campaign().phase=="town" and game.campaign().gold==completed.state.gold and game.campaign().history==completed.state.history,"result return acknowledges without repeating reward or losing history")
	var output=[];OS.execute(OS.get_environment("NATIVE5525_NODE"),PackedStringArray([ProjectSettings.globalize_path("res://tests/feedback_261019_3_fixtures.cjs")]),output,true,false);var cases=JSON.parse_string("".join(output))
	await game.update({"op":"campaign_load","data":cases.cover});await settle();await game.choose_command("attack");await settle()
	var target=game.state().units.filter(func(u):return u.side=="enemy")[0];before=await saved();await game.on_cell(int(target.pos));await settle()
	var hit=game.preview.damagePreview[0];check(hit.targetId!=hit.recipientId and node("RecipientSummary_"+str(hit.recipientId)).text.contains(hit.targetName) and node("RecipientSummary_"+str(hit.recipientId)).text.contains(hit.recipientName),"right preview groups intended target and real cover recipient")
	check(game.board.targets.has(target.id),"fixed selection remains on intended unit")
	var point=game.board.project_cell(int(target.pos));var hover_id=str(game.board.hover_unit_at(point).get("id",""));var motion=InputEventMouseMotion.new();motion.position=point
	game.board.input_event(motion);await settle()
	check(game.board.hover_uid==hover_id and await saved()==before and game.pending==target.id,"pointer hover follows existing portrait/floor hit and preserves selection")
	var cell=game.board.cell_at(point);var clicked=[];game.board.cell_clicked.connect(func(pos):clicked.append(pos))
	for pressed in [true,false]:
		var event=InputEventMouseButton.new();event.button_index=MOUSE_BUTTON_LEFT;event.pressed=pressed;event.position=point;game.board.input_event(event)
	await settle();check(clicked==[cell] and await saved()==before,"pointer click keeps floor hit contract without executing action")
	game.board.hover_uid=target.id;game.hud.inspect_hover(target.id,game.board);await settle()
	check(game.board.hover_caption.contains(hit.recipientName+"が受ける") and game.board.hover_caption.contains("−%d" % hit.hpLoss),"hover predicts actual recipient and exact HP loss")
	check(await saved()==before and game.pending==target.id,"hover preserves selected target and all resources")
	check(game.hud.right_panel.get_theme_stylebox("panel").bg_color.a>=.95,"foreground battle body at least95percent opaque")
	game.cancel();await settle();await game.update({"op":"campaign_load","data":cases.split});await settle();await game.select_skill("splitShot");await settle()
	for id in game.data.choices.skill[0]:await game.on_cell(int(game.hud.unit(id).pos));await settle()
	var commits=game.find_children("*","Button",true,false).filter(func(b):return b.get_meta("ui_key","")=="battle_commit")
	check(commits.size()==1 and commits[0].text==game.hud.command_name()+"を実行","skill confirmation uses action name without extra step")
	before=await saved();game.cancel();await settle();check(await saved()==before,"named skill confirmation cancels without consumption")
	var f=FileAccess.open(evidence.path_join("checks.json"),FileAccess.WRITE);f.store_string(JSON.stringify(checks,"\t"));f.close()
	game.closing=true;await game.audio.finish_audio();game.engine.close_engine();game.queue_free();await frames();quit(0 if checks.all(func(c):return c.passed) else 1)
