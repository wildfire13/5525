extends "res://tests/inventory_header_261020.gd"
const Copy=preload("res://skill_text.gd")
func fixtures2():
 var output=[];OS.execute(OS.get_environment("NATIVE5525_NODE"),PackedStringArray([ProjectSettings.globalize_path("res://tests/feedback_261019_fixtures.cjs")]),output,true,false)
 return JSON.parse_string("".join(output))
func text_checks():
 var c=game.campaign();var before=JSON.stringify(c)
 for id in c.skillDefinitions:
  var d=c.skillDefinitions[id];var doc=Copy.document(id,d.name,1,c)
  check(doc.classification==d.classification and (doc.cost==d.get("cost") or not d.has("cost")),"canonical kind/cost retained "+id)
  check(not doc.original.is_empty() and not Copy.body(doc).is_empty(),"registered effect always available "+id)
 check(JSON.stringify(c)==before,"formatting all registered skills is read-only")
 var sweep=Copy.document("legSweep","足払い",2,c)
 check(sweep.title=="足払いLv2" and sweep.target.begins_with("使用者自身（中心指定）") and sweep.target.contains("効果対象") and sweep.range.contains("8マス") and sweep.original.contains("75%"),"sweep level probability and affected eight enemies distinguish center from effect area")
 var pincer=Copy.document("pincer","挟撃",1,c)
 check(pincer.conditions.size()==2 and str(pincer.conditions[0]).contains("150%") and str(pincer.conditions[1]).contains("100%"),"conditional and normal pincer results are separate original clauses")
 var knock=Copy.document("knockback","吹き飛ばし",1,c)
 check("\n".join(knock.conditions).contains("空いていれば") and "\n".join(knock.conditions).contains("攻撃のみ"),"knockback optional movement does not become a legality restriction")
 var retreat=Copy.document("retreatSlash","退き斬り",1,c)
 check("\n".join(retreat.conditions).contains("使用不可"),"blocked retreat stays unusable rather than attack only")
 var gift=Copy.document("manaGift","魔力譲渡",1,c)
 check(gift.cost==0 and gift.original.contains("最大2") and Copy.glossary().contains("使用者の残量から減"),"zero skill cost is distinguished from transferred MP")
 check(Copy.document("returnHome","帰還",1,c).classification=="active" and Copy.document("returnHome","帰還",1,c).cost==0,"return is active despite equipment effect source")
 check(Copy.document("missing","未知",1,c).cost==null and Copy.document("missing","未知",1,c).classification.is_empty(),"unknown metadata does not acquire guessed values")
 check(Copy.description("invasion",1,c).contains("ポーターは対象外"),"existing invasion permission and porter exclusion are explicit")
 var item=Copy.document("itemUse","アイテム使用",2,c)
 check(item.classification=="passive" and item.target.contains("隣接") and item.range=="該当なし（パッシブ）" and item.original.contains("本人の所持品") and not item.original.contains("共有"),"item level and personal inventory semantics retained")
func run():
 create_timer(180).timeout.connect(func():print("FAIL descriptions watchdog");quit(2))
 if evidence.is_empty() or not OS.get_user_data_dir().begins_with(evidence+"/"):quit(2);return
 root.size=Vector2i(1920,1080);game=load("res://main.tscn").instantiate();root.add_child(game)
 while game.data.is_empty():await process_frame
 await preload("res://tests/current_historical_fixture.gd").install(game)
 game.checks_fast=true;game.audio.fast_mode=true;await settle();text_checks()
 var original=await saved();var cases=fixtures2()
 for dims in [Vector2i(1920,1080),Vector2i(1180,812)]:
  root.size=dims;await game.update({"op":"campaign_load","data":cases.sweep50});await settle();game.hud.open_skills();await settle()
  var before=await saved();await click("BattleSkillDetails_legSweep")
  var detail=node("SkillDetailsWindow")
  check(detail!=null and detail.visible and detail.exclusive,"read-only skill details opens without selecting a skill "+str(dims.x))
  check(node("SkillDetailsSummary").text.contains("周囲8マス") and node("SkillDetailsContext").text.contains("ガロ"),"detail retains actor target and area")
  check(await saved()==before and game.hud.skill_list,"opening details changes no campaign or skill selection")
  detail.size=Vector2i(420,300);await frames()
  check(detail.size.x>=560 and detail.size.y>=560 and Rect2(Vector2.ZERO,Vector2(detail.size)).encloses(node("SkillDetailsActions").get_global_rect()),"detail minimum size keeps fixed summary and back visible")
  node("SkillDetailsTabs").current_tab=1;await frames();check(node("SkillDetailsGlossary").text.contains("スキップ") and node("SkillDetailsGlossary").text.contains("移譲"),"terms are separated from effect body")
  await click("SkillDetailsBack");check(node("SkillDetailsWindow")==null and game.hud.skill_list,"close returns to original skill menu")
  await game.select_skill("legSweep");await settle();var pending=game.pending;var preview=game.preview.duplicate(true);before=await saved()
  game.show_skill_details("legSweep","足払い",1);await settle();await click("SkillDetailsBack")
  check(game.pending==pending and game.preview==preview and await saved()==before and game.can_commit(),"details preserve selected target prediction and readiness")
  game.cancel();await settle();check(await saved()==before,"target cancellation still consumes nothing")
  var long_doc=Copy.document("pincer","長いスキル名".repeat(12),1,game.campaign());long_doc.conditions=[];long_doc.limits=[];long_doc.effect=["長い説明を確認するための文字列。".repeat(180)+"最終行の確認"]
  detail=load("res://skill_details.gd").new();game.add_child(detail);detail.configure(game,long_doc,"ガロ / 相棒の短剣","原文メモをそのまま表示");await settle()
  var summary=node("SkillDetailsSummary");var back=node("SkillDetailsBack");var body=node("SkillDetailsBody");var scroll=body.get_parent();var summary_at=summary.get_global_rect();var back_at=back.get_global_rect()
  scroll.scroll_vertical=100000;await frames()
  check(scroll.get_v_scroll_bar().max_value>scroll.size.y and scroll.scroll_vertical>0,"long effect text has real overflow and reaches its end "+str(dims.x))
  check(summary.get_global_rect()==summary_at and back.get_global_rect()==back_at,"only explanation scrolls; target/range/back stay fixed")
  check(body.text.ends_with("最終行の確認") and Rect2(Vector2.ZERO,Vector2(root.size)).encloses(Rect2(Vector2(detail.position),Vector2(detail.size))),"last line retained and detail window remains inside screen")
  node("SkillDetailsTabs").current_tab=2;await frames();check(node("SkillDetailsNote").text=="原文メモをそのまま表示","equipment note remains verbatim and separate")
  await click("SkillDetailsBack")
  var town=original.duplicate(true);town.state.location="east";town.state.characters.guard.inventory={"kungfu-pants":1}
  await game.update({"op":"campaign_load","data":town});await enter_facility("shop");game.pages.party_view.open_detail("guard");await settle()
  var tip=node("OwnedEquipment_kungfu-pants").tooltip_text
  check(tip.contains("周囲8マス") and tip.contains("50%") and tip.contains("装備の基礎能力") and tip.contains("装備メモ（原文）"),"owned pants use canonical effect instead of truncated item note")
  check(not tip.contains("スキル射程：1\n"),"fractional square range is never truncated to orthogonal one")
  await click("OwnedEquipment_kungfu-pants");before=await saved();node("InventoryDetails").grab_focus();await click("InventoryDetails")
  check(node("SkillDetailsBody").text.contains("50%") and node("SkillDetailsBody").text.contains("装備の基礎能力") and node("SkillDetailsContext").text.contains("ガロ"),"unequipped item has a full read-only effect and base-stat explanation")
  var entry=game.pages.party_view.inventory_view.selected()
  node("SkillDetailsTabs").current_tab=2;await frames()
  check(node("SkillDetailsNote").text==entry.definition.note,"unequipped item note is preserved verbatim in separate scroll tab")
  await click("SkillDetailsBack")
  check(await saved()==before and game.pages.party_view.inventory_view.item_id=="kungfu-pants" and node("InventoryDetails").has_focus(),"equipment explanation closes to same selected item and focus without mutation")
  await click("StatusTab_2");before=await saved();game.show_skill_details("guard","かばう",1);await settle()
  var status=game.dialog.window;detail=node("SkillDetailsWindow")
  check(detail.get_parent()==status and game.pages.party_view.detail_uid=="guard","nested detail retains original character status window")
  await click("SkillDetailsBack");check(game.dialog.window==status and await saved()==before,"nested close preserves status owner and exact state")
  game.locked=true;game.show_skill_details("guard","かばう",1);await frames();check(node("SkillDetailsWindow")==null,"pending state update cannot open stale character explanation");game.locked=false
  game.show_skill_details("guard","かばう",1);await settle();var old_token=game.campaign().inventoryToken;game.data.campaign.inventoryToken="changed-presentation-context";await frames()
  check(node("SkillDetailsWindow")==null,"read-only explanation expires when canonical inventory context changes");game.data.campaign.inventoryToken=old_token
  game.dialog.close();await settle()
 check(game.audio.muted.bgm and game.audio.muted.voice and game.audio.muted.se,"all descriptions checks keep audio OFF")
 var f=FileAccess.open(evidence.path_join("research2-description-checks.json"),FileAccess.WRITE);f.store_string(JSON.stringify(checks,"\t"));f.close()
 game.closing=true;await game.audio.finish_audio();game.engine.close_engine();game.queue_free();await frames();quit(0 if checks.all(func(c):return c.passed) else 1)
