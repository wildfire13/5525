extends "res://tests/inventory_header_261020.gd"
const Copy=preload("res://skill_text.gd")
func fixtures2():
 var output=[];OS.execute(OS.get_environment("NATIVE5525_NODE"),PackedStringArray([ProjectSettings.globalize_path("res://tests/research_current_fixtures.cjs")]),output,true,false)
 return JSON.parse_string("".join(output))
func text_checks():
 var c=game.campaign();var before=JSON.stringify(c)
 for id in c.skillDefinitions:
  var d=c.skillDefinitions[id];var doc=Copy.document(id,d.name,1,c)
  check(doc.classification==d.classification and (doc.cost==d.get("cost") or not d.has("cost")),"canonical kind/cost retained "+id)
  check(not doc.original.is_empty() and not Copy.body(doc).is_empty(),"registered effect always available "+id)
 check(JSON.stringify(c)==before,"formatting all registered skills is read-only")
 var sweep=Copy.document("skill_leg_sweep","足払い",2,c)
 check(sweep.title=="足払いLv2" and sweep.target.begins_with("使用者自身（中心指定）") and sweep.target.contains("効果対象") and sweep.range.contains("8マス") and sweep.original.contains("75%"),"sweep level probability and affected eight enemies distinguish center from effect area")
 for level in [1,2,3]:
  var ambush=Copy.document("skill_ambush","奇襲",level,c)
  var body=Copy.body(ambush)
  var direction=["前方（味方は右、敵は左）","同じ横列の左右","上下左右の直線"][level-1]
  check(ambush.target=="敵1人" and body.contains(direction) and body.count("距離制限なし")==1 and body.contains("敵の手前") and body.contains("他のキャラクターがいない"),"ambush target, direction and path at level "+str(level))
 var pincer=Copy.document("skill_pincer","挟撃",1,c)
 check(pincer.conditions.size()==2 and str(pincer.conditions[0]).contains("150%") and str(pincer.conditions[1]).contains("100%"),"conditional and normal pincer results are separate original clauses")
 var knock=Copy.document("skill_knockback","吹き飛ばし",1,c)
 check("\n".join(knock.conditions).contains("空いていれば") and "\n".join(knock.conditions).contains("攻撃のみ"),"knockback optional movement does not become a legality restriction")
 var retreat=Copy.document("skill_retreat_slash","退き斬り",1,c)
 check("\n".join(retreat.conditions).contains("使用不可"),"blocked retreat stays unusable rather than attack only")
 var gift=Copy.document("skill_mana_gift","魔力譲渡",1,c)
 check(gift.cost==0 and gift.original.contains("最大2") and Copy.body(gift).contains("最大2"),"zero skill cost and original transfer limit remain visible")
 check(Copy.document("skill_return_home","帰還",1,c).classification=="active" and Copy.document("skill_return_home","帰還",1,c).cost==0,"return is active despite equipment effect source")
 check(Copy.document("missing","未知",1,c).cost==null and Copy.document("missing","未知",1,c).classification.is_empty(),"unknown metadata does not acquire guessed values")
 check(Copy.description("skill_invasion",1,c).contains("ポーターは対象外"),"existing invasion permission and porter exclusion are explicit")
 var item=Copy.document("skill_item_use","アイテム使用",2,c)
 check(item.classification=="passive" and item.target.contains("隣接") and item.range=="該当なし（パッシブ）" and item.original.contains("本人の所持品") and not item.original.contains("共有"),"item level and personal inventory semantics retained")
 var boost=Copy.document("skill_formation_boost","陣形強化",1,c)
 var boost_body=Copy.body(boost)
 # 指示14: 射程の概念がないため「射程・範囲」行を出さない。
 check(boost.range.is_empty() and not boost_body.contains("射程・範囲") and not boost_body.contains("成立中の陣形"),"formation boost has no fabricated range line")
 # 指示12/13: 対象は陣形の内外を問わず味方全員。
 check(boost.target=="味方全員","formation boost targets every ally, inside or outside the formation")
 # 指示11: 味方全員・3マス外・倍率の置き換えという効果本文は維持。
 for phrase in ["味方全員","3マス外","×1.5","×0.75","×1.75","×0.65","置き換え","使用者の次の番まで","加算されません"]:check(boost_body.contains(phrase),"formation boost effect keeps "+phrase)
func run():
 create_timer(180).timeout.connect(func():print("FAIL descriptions watchdog");quit(2))
 if evidence.is_empty() or not OS.get_user_data_dir().begins_with(evidence+"/"):quit(2);return
 root.size=Vector2i(1920,1080);game=load("res://main.tscn").instantiate();root.add_child(game)
 while game.data.is_empty():await process_frame
 game.checks_fast=true;game.audio.fast_mode=true;await settle();text_checks()
 var original=await saved();var cases=fixtures2()
 var owner_name=str(game.campaign().roster.filter(func(c):return c.id==INVENTORY_OWNER)[0].name)
 for dims in [Vector2i(1920,1080)]:
  root.size=dims;await game.update({"op":"campaign_load","data":cases.sweep50});await settle();game.hud.open_skills();await settle()
  var before=await saved();await click("BattleSkillDetails_skill_leg_sweep")
  var detail=node("SkillDetailsWindow")
  check(detail!=null and detail.visible and detail.exclusive,"read-only skill details opens without selecting a skill "+str(dims.x))
  check(not node("SkillDetailsSummary").text.contains("対象:") and node("SkillDetailsBody").text.contains("周囲8マス") and node("SkillDetailsContext")==null,"skill scope is in effect tab without actor line")
  check(await saved()==before and game.hud.skill_list,"opening details changes no campaign or skill selection")
  var detail_area=Rect2(Vector2.ZERO,Vector2(detail.size))
  var frame=preload("res://window_grid.gd").frame_rect(Vector2(root.size))
  check(detail.size==Vector2i(frame.size) and detail_area.encloses(node("SkillDetailsSummary").get_global_rect()) and detail_area.encloses(node("SkillDetailsActions").get_global_rect()) and detail_area.encloses(node("SkillDetailsBack").get_global_rect()),"FHD detail opens in the shared frame and keeps summary and back visible")
  check(node("SkillDetailsTabs").is_tab_disabled(1) and node("SkillDetailsGlossary").text.is_empty(),"unused terms tab is disabled and empty")
  await click("SkillDetailsBack");check(node("SkillDetailsWindow")==null and game.hud.skill_list,"close returns to original skill menu")
  await game.select_skill("skill_leg_sweep");await settle();var pending=game.pending;var preview=game.preview.duplicate(true);before=await saved()
  game.show_skill_details("skill_leg_sweep","足払い",1);await settle();await click("SkillDetailsBack")
  check(game.pending==pending and game.preview==preview and await saved()==before and game.can_commit(),"details preserve selected target prediction and readiness")
  game.cancel();await settle();check(await saved()==before,"target cancellation still consumes nothing")
  var long_doc=Copy.document("skill_pincer","長いスキル名".repeat(12),1,game.campaign());long_doc.conditions=[];long_doc.limits=[];long_doc.effect=["長い説明を確認するための文字列。".repeat(180)+"最終行の確認"]
  detail=load("res://skill_details.gd").new();game.add_child(detail);detail.configure(game,long_doc,owner_name+" / 足払い","原文メモをそのまま表示");await settle()
  var summary=node("SkillDetailsSummary");var back=node("SkillDetailsBack");var body=node("SkillDetailsBody");var scroll=body.get_parent();var summary_at=summary.get_global_rect();var back_at=back.get_global_rect()
  scroll.scroll_vertical=100000;await frames()
  check(scroll.get_v_scroll_bar().max_value>scroll.size.y and scroll.scroll_vertical>0,"long effect text has real overflow and reaches its end "+str(dims.x))
  check(summary.get_global_rect()==summary_at and back.get_global_rect()==back_at,"effect and scope scroll while classification cost and back stay fixed")
  check(body.text.ends_with("最終行の確認") and Rect2(Vector2.ZERO,Vector2(root.size)).encloses(Rect2(Vector2(detail.position),Vector2(detail.size))),"last line retained and detail window remains inside screen")
  node("SkillDetailsTabs").current_tab=node("SkillDetailsNote").get_parent().get_index();await frames();check(node("SkillDetailsNote").text=="原文メモをそのまま表示","equipment note remains verbatim and separate")
  await click("SkillDetailsBack")
  var town=original.duplicate(true);town.state.location="east";town.state.characters[INVENTORY_OWNER].inventory={"kungfu-pants":1}
  await game.update({"op":"campaign_load","data":town});await enter_facility("shop");game.pages.party_view.open_inventory(INVENTORY_OWNER);await settle()
  character_item(INVENTORY_OWNER,"kungfu-pants").pressed.emit();await settle()
  before=await saved();node("CharacterItemDetails").grab_focus();await click("CharacterItemDetails")
  check(node("SkillDetailsBody").text.contains("周囲8マス") and not node("SkillDetailsSummary").text.contains("スキル射程：1\n"),"pants retain full square area")
  var entry=game.pages.party_view.workspace.picked
  check(node("SkillDetailsBody").text.contains("50%") and node("SkillDetailsBody").text.contains("装備の基礎能力") and node("SkillDetailsTitle").text==entry.name and game.pages.party_uid==INVENTORY_OWNER,"shared item details show the selected owner's equipment, full effect and base stats")
  node("SkillDetailsTabs").current_tab=node("SkillDetailsNote").get_parent().get_index();await frames()
  check(node("SkillDetailsNote").text==entry.definition.note,"unequipped item note is preserved verbatim in separate scroll tab")
  await click("SkillDetailsBack")
  check(await saved()==before and game.pages.party_view.workspace.picked.id=="kungfu-pants" and node("CharacterItemDetails").has_focus(),"equipment explanation closes to same selected item and focus without mutation")
  game.pages.party_view.workspace.set_tab("skills");await settle();before=await saved()
  var skill=game.find_child("CharacterSkill_*_skill_cover_*",true,false)
  skill.grab_focus();skill.pressed.emit();await settle()
  check(node("SkillDetailsWindow")!=null and game.pages.party_uid==INVENTORY_OWNER,"skill opens for selected member")
  await click("SkillDetailsBack");check(skill.has_focus() and await saved()==before,"close restores selected skill and exact state")
  game.locked=true;game.show_skill_details("skill_cover","かばう",1);await frames();check(node("SkillDetailsWindow")==null,"pending state update cannot open stale character explanation");game.locked=false
  game.show_skill_details("skill_cover","かばう",1);await settle();var old_token=game.campaign().inventoryToken;game.data.campaign.inventoryToken="changed-presentation-context";await frames()
  check(node("SkillDetailsWindow")==null,"read-only explanation expires when canonical inventory context changes");game.data.campaign.inventoryToken=old_token
  game.dialog.close();await settle()
 check(game.audio.muted.bgm and game.audio.muted.voice and game.audio.muted.se,"all descriptions checks keep audio OFF")
 var f=FileAccess.open(evidence.path_join("research2-description-checks.json"),FileAccess.WRITE);f.store_string(JSON.stringify(checks,"\t"));f.close()
 game.closing=true;await game.audio.finish_audio();game.engine.close_engine();game.queue_free();await frames();quit(0 if checks.all(func(c):return c.passed) else 1)
