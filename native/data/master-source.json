  "definitions": {
    "itemUse": {
      "name": "拳",
      "classification": "passive",
      "cost": 0,
      "target": "item",
      "description": "バトル中にもアイテムを使用できる。本人の所持品を1個使用。Lv1は自身のみ、Lv2は自身と隣接する味方、Lv3は距離制限なし。MP0。"
    },
    "legSweep": {
      "name": "足払い",
      "classification": "active",
      "cost": 1,
      "reach": 1.5,
      "target": "self",
      "description": "周囲8マスの敵それぞれに足払い判定。Lv1:50%、Lv2:75%、Lv3:100%。ダメージ0、成功時は次の1手番をスキップ（重複なし）。MP1。"
    },
    "grapple": {
      "name": "引き寄せ",
      "classification": "active",
      "cost": 1,
      "reach": 2,
      "target": "unit",
      "description": "右2マス先の敵味方を1マス引き寄せる。途中が占有されている場合もMP1と行動を消費するが移動しない。"
    },
    "poleVault": {
      "name": "ポールヴォールト",
      "classification": "active",
      "cost": 1,
      "reach": 2,
      "target": "cell",
      "description": "上下左右2マス先へ跳躍。途中の空き・人物を問わず、盤内の移動可能な空きマスに着地。MP1。"
    },
    "swift": {
      "name": "俊足",
      "classification": "passive",
      "description": "通常移動力+1。先駆けと加算（暫定）：通常3、初回4。侵入制限・行動数は変更しない。"
    },
    "retreatSlash": {
      "name": "退き斬り",
      "classification": "active",
      "cost": 1,
      "reach": 1,
      "target": "unit",
      "description": "射程1の敵へ70%攻撃後、自陣側へ1マス後退。退路が塞がる／盤外なら使用不可。MP1。"
    },
    "knockback": {
      "name": "吹き飛ばし",
      "classification": "active",
      "cost": 1,
      "reach": 1,
      "target": "unit",
      "description": "射程1の敵へ通常攻撃。対象の先が空いていれば1マス押す。盤外・占有時は攻撃のみ。MP1。"
    },
    "splitShot": {
      "name": "分け撃ち",
      "classification": "active",
      "cost": 1,
      "reach": 3,
      "target": "pair",
      "description": "射程3の異なる敵2体を順に指定し、各60%攻撃。同じ敵への集中不可。MP1。"
    },
    "pincer": {
      "name": "挟撃",
      "classification": "active",
      "cost": 1,
      "reach": 1,
      "target": "unit",
      "description": "射程1の敵へ攻撃。対象に別の生存味方が縦横隣接していれば150%、それ以外100%。MP1。"
    },
    "healingCross": {
      "name": "癒しの輪",
      "classification": "active",
      "cost": 2,
      "reach": 2,
      "target": "unit",
      "description": "射程2の生存味方を中心に、中心＋上下左右の生存味方のHPを各30回復。MP2。"
    },
    "defenseLine": {
      "name": "防衛線",
      "classification": "active",
      "cost": 1,
      "reach": 1,
      "target": "upToTwo",
      "description": "縦横隣接の味方を1～2人指定。次の本人の番までかばう。同じ対象の重複指定不可。MP1。"
    },
    "manaGift": {
      "name": "魔力譲渡",
      "classification": "active",
      "cost": 0,
      "reach": 2,
      "target": "unit",
      "description": "射程2の別の生存味方へMPを最大2移譲。自分の残量・相手の空き分まで。総量は増えない。1行動。"
    },
    "returnHome": {
      "name": "帰還",
      "classification": "active",
      "cost": 0,
      "reach": null,
      "target": "cell",
      "description": "付与元ごとに1戦1回、自陣の指定空きマスへ帰還。MP0、1行動。使用回数はクールタイムで回復しない。"
    },
